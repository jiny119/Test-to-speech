{
    "builds": [
        { 
            "src": "api/tts.py", 
            "use": "@vercel/python" 
        }
    ],
    "routes": [
        { 
            "src": "/api/tts", 
            "dest": "/api/tts.py", 
            "methods": ["POST", "OPTIONS"] 
        },
        { 
            "src": "/(.*)", 
            "dest": "/index.html" 
        }
    ]
}
